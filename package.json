{
  "name": "upside-down-run",
  "version": "1.0.0",
  "description": "Upside Down Run - an original 2D gravity-flip physics puzzle platformer (Phaser 3 + TypeScript + Vite)",
  "private": true,
  "type": "module",
  "scripts": {
    "levels": "node tools/buildLevels.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && SINGLE=1 vite build",
    "preview": "vite preview",
    "verify": "node tools/verifyLevels.mjs"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
